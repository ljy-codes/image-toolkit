<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#1F2227</Color>
    <Color x:Key="SurfaceColor">#292D33</Color>
    <Color x:Key="SurfaceAltColor">#24282E</Color>
    <Color x:Key="BorderColor">#424852</Color>
    <Color x:Key="TextPrimaryColor">#F3F5F7</Color>
    <Color x:Key="TextSecondaryColor">#B1B8C2</Color>
    <Color x:Key="PrimaryColor">#5B9CFA</Color>
    <Color x:Key="PrimaryHoverColor">#78AEFA</Color>
    <Color x:Key="SelectionColor">#243D61</Color>
    <Color x:Key="SuccessColor">#61C98A</Color>
    <Color x:Key="WarningColor">#F4B35B</Color>
    <Color x:Key="DangerColor">#F27D7D</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
</ResourceDictionary>
