<Window
    x:Class="ImageToolkit.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{DynamicResource AppTitle}"
    Width="1320"
    Height="820"
    MinWidth="1024"
    MinHeight="680"
    AllowDrop="True"
    Closing="OnWindowClosing"
    DragEnter="OnDragEnter"
    Drop="OnDrop"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Background="{DynamicResource WorkspaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.RowSpan="3"
            Background="{DynamicResource SurfaceAltBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="图批处理"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Style="{StaticResource SecondaryText}"
                        Text="本地图片工作台" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,30,0,0">
                    <TextBlock Margin="0,0,0,13" FontWeight="SemiBold" Text="文件" />
                    <TextBlock Margin="0,0,0,13" Style="{StaticResource SecondaryText}" Text="尺寸与比例" />
                    <TextBlock Margin="0,0,0,13" Style="{StaticResource SecondaryText}" Text="背景与压缩" />
                    <TextBlock Margin="0,0,0,13" Style="{StaticResource SecondaryText}" Text="元数据" />
                    <TextBlock Style="{StaticResource SecondaryText}" Text="输出" />
                </StackPanel>

                <Border
                    Grid.Row="3"
                    Padding="10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding FileQueue.Items.Count, StringFormat=队列 {0} 张}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource SecondaryText}"
                            Text="JPEG · PNG · WebP · BMP · TIFF"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Padding="18,12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Command="{Binding AddFilesCommand}"
                    Content="{DynamicResource AddFilesText}" />
                <Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Command="{Binding AddFolderCommand}"
                    Content="{DynamicResource AddFolderText}" />
                <Button
                    Grid.Column="3"
                    Style="{StaticResource IconButton}"
                    Command="{Binding RemoveSelectedCommand}"
                    Content="&#xE74D;"
                    ToolTip="移除选中图片" />
                <Button
                    Grid.Column="4"
                    Margin="8,0,0,0"
                    Style="{StaticResource IconButton}"
                    Command="{Binding ClearQueueCommand}"
                    Content="&#xE894;"
                    ToolTip="清空队列" />
                <CheckBox
                    Grid.Column="6"
                    IsChecked="{Binding IncludeSubdirectories}"
                    Content="包含子文件夹" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="260" />
                <RowDefinition Height="14" />
                <RowDefinition Height="2*" MinHeight="210" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <TextBlock
                            Margin="14,10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            FontWeight="SemiBold"
                            Text="{DynamicResource OriginalPreviewText}" />
                        <Image
                            Margin="12,40,12,12"
                            Source="{Binding Preview.OriginalImage}"
                            Stretch="Uniform"
                            SnapsToDevicePixels="True" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <TextBlock
                            Margin="14,10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            FontWeight="SemiBold"
                            Text="{DynamicResource ProcessedPreviewText}" />
                        <Image
                            Margin="12,40,12,34"
                            Source="{Binding Preview.ProcessedImage}"
                            Stretch="Uniform"
                            SnapsToDevicePixels="True" />
                        <TextBlock
                            Margin="14,0,14,10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource SecondaryText}"
                            Text="{Binding Preview.Caption}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="0,0,0,8"
                    Style="{StaticResource SectionHeader}"
                    Text="{DynamicResource QueueText}" />
                <ListView
                    x:Name="FileList"
                    Grid.Row="1"
                    ItemsSource="{Binding FileQueue.Items}"
                    SelectedItem="{Binding FileQueue.SelectedItem}"
                    SelectionMode="Extended">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Width="260" Header="文件名">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding FileName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding SourcePath}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="120" Header="尺寸" DisplayMemberBinding="{Binding Dimensions}" />
                            <GridViewColumn Width="90" Header="大小" DisplayMemberBinding="{Binding SizeText}" />
                            <GridViewColumn Width="90" Header="状态" DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Width="220" Header="输出">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding OutputPath, TargetNullValue=—}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding OutputPath}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>

        <Border
            Grid.Row="1"
            Grid.Column="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1,0,0,0">
            <ScrollViewer
                Padding="18"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource SettingsText}" />

                    <Expander Header="压缩" IsExpanded="True">
                        <StackPanel Margin="0,10,0,0">
                            <CheckBox IsChecked="{Binding Settings.CompressionEnabled}" Content="限制文件大小" />
                            <TextBlock Margin="0,10,0,5" Style="{StaticResource FieldLabel}" Text="目标大小（MB）" />
                            <TextBox Text="{Binding Settings.TargetMegabytes, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox
                                Margin="0,8,0,0"
                                IsChecked="{Binding Settings.AllowPngQuantization}"
                                Content="允许 PNG 有损量化" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="尺寸与比例" IsExpanded="True">
                        <StackPanel Margin="0,10,0,0">
                            <CheckBox IsChecked="{Binding Settings.ResizeEnabled}" Content="调整图片尺寸" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="宽度" />
                                    <TextBox Text="{Binding Settings.Width, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="高度" />
                                    <TextBox Text="{Binding Settings.Height, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                </StackPanel>
                            </Grid>
                            <CheckBox IsChecked="{Binding Settings.LockAspectRatio}" Content="锁定原始比例" />
                            <TextBlock Margin="0,10,0,5" Style="{StaticResource FieldLabel}" Text="画面比例" />
                            <ComboBox
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Settings.AspectRatioModes}"
                                SelectedValue="{Binding Settings.AspectRatioMode}"
                                SelectedValuePath="Value" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Settings.RatioWidth, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text=":" />
                                <TextBox Grid.Column="2" Text="{Binding Settings.RatioHeight, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <TextBlock Margin="0,8,0,5" Style="{StaticResource FieldLabel}" Text="裁剪锚点" />
                            <ComboBox
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Settings.CropAnchors}"
                                SelectedValue="{Binding Settings.CropAnchor}"
                                SelectedValuePath="Value" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="背景" IsExpanded="False">
                        <StackPanel Margin="0,10,0,0">
                            <ComboBox
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Settings.BackgroundModes}"
                                SelectedValue="{Binding Settings.BackgroundMode}"
                                SelectedValuePath="Value" />
                            <TextBlock Margin="0,8,0,5" Style="{StaticResource FieldLabel}" Text="自定义颜色" />
                            <TextBox Text="{Binding Settings.CustomBackgroundColor, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="0,7,0,0"
                                Foreground="{DynamicResource WarningBrush}"
                                Text="{Binding Settings.Notice}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="元数据" IsExpanded="False">
                        <StackPanel Margin="0,10,0,0">
                            <CheckBox IsChecked="{Binding Settings.PreserveExif}" Content="保留 EXIF" />
                            <CheckBox IsChecked="{Binding Settings.PreserveGps}" Content="保留 GPS 信息" />
                            <CheckBox IsChecked="{Binding Settings.PreserveIccProfile}" Content="保留 ICC 色彩配置" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="输出" IsExpanded="True">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="输出格式" />
                            <ComboBox
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Settings.OutputFormats}"
                                SelectedValue="{Binding Settings.OutputFormat}"
                                SelectedValuePath="Value" />
                            <TextBlock Margin="0,8,0,5" Style="{StaticResource FieldLabel}" Text="保存位置" />
                            <ComboBox
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Settings.OutputModes}"
                                SelectedValue="{Binding Settings.OutputMode}"
                                SelectedValuePath="Value" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    IsReadOnly="True"
                                    Text="{Binding Settings.OutputDirectory, TargetNullValue=未选择}" />
                                <Button
                                    Grid.Column="2"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding ChooseOutputFolderCommand}"
                                    Content="&#xE8B7;"
                                    ToolTip="选择输出文件夹" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander Header="外观" IsExpanded="False">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="主题" />
                            <ComboBox
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Appearance.ThemeOptions}"
                                SelectedValue="{Binding Appearance.Theme}"
                                SelectedValuePath="Value" />
                            <TextBlock Margin="0,8,0,5" Style="{StaticResource FieldLabel}" Text="工作区背景" />
                            <ComboBox
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Appearance.BackgroundOptions}"
                                SelectedValue="{Binding Appearance.WorkspaceBackground}"
                                SelectedValuePath="Value" />
                            <TextBlock Margin="0,8,0,5" Style="{StaticResource FieldLabel}" Text="自定义背景色" />
                            <TextBox Text="{Binding Appearance.CustomWorkspaceColor, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,8,0,5" Style="{StaticResource FieldLabel}" Text="字体大小" />
                            <ComboBox
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Appearance.FontSizeOptions}"
                                SelectedValue="{Binding Appearance.FontSize}"
                                SelectedValuePath="Value" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border
            Grid.Row="2"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Padding="18,12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="{Binding Progress.StatusText}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryText}"
                            Text="{Binding Progress.Percentage, StringFormat={}{0:F0}%}" />
                    </Grid>
                    <ProgressBar Margin="0,7,0,0" Value="{Binding Progress.Percentage}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Command="{Binding PauseResumeCommand}"
                    Content="{Binding PauseButtonText}" />
                <Button
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    Style="{StaticResource DangerButton}"
                    Command="{Binding CancelCommand}"
                    Content="取消" />
                <Button
                    Grid.Column="3"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding StartCommand}"
                    Content="{DynamicResource StartText}" />
            </Grid>
        </Border>
    </Grid>
</Window>
