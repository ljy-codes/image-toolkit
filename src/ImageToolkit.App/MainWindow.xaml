<Window
    x:Class="ImageToolkit.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{DynamicResource AppTitle}"
    Width="1320"
    Height="820"
    MinWidth="1024"
    MinHeight="680"
    AllowDrop="True"
    Closing="OnWindowClosing"
    DragEnter="OnDragEnter"
    Drop="OnDrop"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Background="{DynamicResource WorkspaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.RowSpan="3"
            Background="{DynamicResource SurfaceAltBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="苏影枢"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Style="{StaticResource SecondaryText}"
                        Text="本地图片工作台" />
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Margin="0,28,0,0"
                    Padding="14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel>
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{Binding FileQueue.Items.Count, StringFormat=队列 {0} 张}" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Style="{StaticResource SecondaryText}"
                            Text="{Binding Progress.StatusText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,24,0,0">
                    <TextBlock Margin="0,0,0,10" FontWeight="SemiBold" Text="队列操作" />
                    <Button
                        Command="{Binding RemoveSelectedCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=FileList}"
                        Content="移除选中图片" />
                    <Button
                        Margin="0,8,0,0"
                        Command="{Binding ClearQueueCommand}"
                        Content="清空队列" />
                    <TextBlock
                        Margin="0,20,0,0"
                        Style="{StaticResource SecondaryText}"
                        Text="可将图片或文件夹直接拖入工作区。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border
                    Grid.Row="3"
                    Padding="10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="支持格式" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource SecondaryText}"
                            Text="JPEG · PNG · WebP · BMP · TIFF"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Padding="18,12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Command="{Binding AddFilesCommand}"
                    Content="{DynamicResource AddFilesText}" />
                <Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Command="{Binding AddFolderCommand}"
                    Content="{DynamicResource AddFolderText}" />
                <CheckBox
                    Grid.Column="2"
                    Margin="14,0,0,0"
                    IsChecked="{Binding IncludeSubdirectories}"
                    Content="包含子文件夹" />
                <StackPanel
                    Grid.Column="3"
                    Margin="20,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding WorkspaceTitle}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SecondaryText}"
                        Text="{Binding Progress.StatusText}" />
                </StackPanel>
                <TextBlock
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryText}"
                    Text="拖入图片或文件夹也可导入" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="260" />
                <RowDefinition Height="14" />
                <RowDefinition Height="2*" MinHeight="210" />
            </Grid.RowDefinitions>

            <TabControl>
                <TabItem Header="处理后">
                    <Border
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid>
                            <Image
                                Margin="14,14,14,38"
                                Source="{Binding Preview.ProcessedImage}"
                                Stretch="Uniform"
                                SnapsToDevicePixels="True" />
                            <TextBlock
                                Margin="14,0,14,10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource SecondaryText}"
                                Text="{Binding Preview.Caption}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="左右对比">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid>
                                <TextBlock
                                    Margin="14,10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource OriginalPreviewText}" />
                                <Image
                                    Margin="12,40,12,12"
                                    Source="{Binding Preview.OriginalImage}"
                                    Stretch="Uniform"
                                    SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>
                        <Border
                            Grid.Column="2"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid>
                                <TextBlock
                                    Margin="14,10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource ProcessedPreviewText}" />
                                <Image
                                    Margin="12,40,12,34"
                                    Source="{Binding Preview.ProcessedImage}"
                                    Stretch="Uniform"
                                    SnapsToDevicePixels="True" />
                                <TextBlock
                                    Margin="14,0,14,10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource SecondaryText}"
                                    Text="{Binding Preview.Caption}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="0,0,0,8"
                    Style="{StaticResource SectionHeader}"
                    Text="{DynamicResource QueueText}" />
                <ListView
                    x:Name="FileList"
                    Grid.Row="1"
                    ItemsSource="{Binding FileQueue.Items}"
                    SelectedItem="{Binding FileQueue.SelectedItem}"
                    SelectionChanged="OnQueueSelectionChanged"
                    SelectionMode="Extended">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Width="260" Header="文件名">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding FileName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding SourcePath}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="120" Header="尺寸" DisplayMemberBinding="{Binding Dimensions}" />
                            <GridViewColumn Width="90" Header="大小" DisplayMemberBinding="{Binding SizeText}" />
                            <GridViewColumn Width="90" Header="状态" DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Width="340" Header="处理结果 / 原因">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding ResultDetails, TargetNullValue=—}"
                                            TextWrapping="Wrap"
                                            ToolTip="{Binding Message}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="220" Header="输出路径">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding OutputPath, TargetNullValue=—}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding OutputPath}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>

        <Border
            Grid.Row="1"
            Grid.Column="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1,0,0,0">
            <Grid Margin="18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource SettingsText}" />
                <TabControl Grid.Row="1">
                    <TabControl.Style>
                        <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TabControl.Style>

                    <TabItem Header="参数方案">
                        <ScrollViewer
                            Padding="2,12,8,8"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <GroupBox Header="参数方案">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock
                                Margin="0,0,0,7"
                                Style="{StaticResource SecondaryText}"
                                Text="保存常用处理参数，下次可直接选择复用。"
                                TextWrapping="Wrap" />
                            <ComboBox
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding Presets.Items}"
                                SelectedItem="{Binding Presets.SelectedPreset}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding Presets.ApplySelectedCommand}" Content="应用" />
                                <Button Grid.Column="2" Command="{Binding Presets.UpdateSelectedCommand}" Content="更新" />
                                <Button Grid.Column="4" Command="{Binding Presets.RenameSelectedCommand}" Content="重命名" />
                                <Button Grid.Column="6" Command="{Binding Presets.DeleteSelectedCommand}" Content="删除" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <TextBox
                                    x:Name="PresetNameTextBox"
                                    Text="{Binding Presets.PresetName, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="输入新方案名称，或输入新名称后重命名当前方案" />
                                <TextBlock
                                    Margin="10,0"
                                    IsHitTestVisible="False"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="输入方案名称">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PresetNameTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=PresetNameTextBox}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button
                                Margin="0,8,0,0"
                                Command="{Binding Presets.SaveAsCommand}"
                                Content="另存为新方案" />
                            <Button
                                Margin="0,8,0,0"
                                Command="{Binding Settings.ResetToDefaultsCommand}"
                                Content="恢复默认参数" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Command="{Binding ImportConfigurationCommand}"
                                    Content="导入配置"
                                    ToolTip="从 .syconfig 文件恢复当前参数、外观和全部命名方案" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding ExportConfigurationCommand}"
                                    Content="导出配置"
                                    ToolTip="将当前参数、外观和全部命名方案保存为 .syconfig 文件" />
                            </Grid>
                            <TextBlock
                                Margin="0,7,0,0"
                                Style="{StaticResource SecondaryText}"
                                Text="{Binding ConfigurationNotice}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,7,0,0"
                                Foreground="{DynamicResource WarningBrush}"
                                Text="{Binding Presets.Notice}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                            </GroupBox>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="基础处理" IsSelected="True">
                        <ScrollViewer
                            Padding="2,12,8,8"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                    <GroupBox Header="压缩">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock
                                Margin="0,0,0,7"
                                Style="{StaticResource SecondaryText}"
                                Text="压缩：限制输出文件体积。无法达到目标时判为未处理，不保留超标文件。"
                                TextWrapping="Wrap" />
                            <CheckBox IsChecked="{Binding Settings.CompressionEnabled}" Content="限制文件大小" />
                            <TextBlock Margin="0,10,0,5" Style="{StaticResource FieldLabel}" Text="目标大小（MB）" />
                            <TextBox Text="{Binding Settings.TargetMegabytes, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="JPEG 最低质量（20-95）" />
                                    <TextBox Text="{Binding Settings.MinimumJpegQuality, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="WebP 最低质量（20-95）" />
                                    <TextBox Text="{Binding Settings.MinimumWebpQuality, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <CheckBox
                                Margin="0,8,0,0"
                                IsChecked="{Binding Settings.AllowPngQuantization}"
                                Content="允许 PNG 有损量化" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Margin="0,16,0,0" Header="尺寸与比例">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock
                                Margin="0,0,0,7"
                                Style="{StaticResource SecondaryText}"
                                Text="尺寸：默认保留原尺寸；启用后才需要填写宽度或高度。"
                                TextWrapping="Wrap" />
                            <CheckBox IsChecked="{Binding Settings.ResizeEnabled}" Content="调整图片尺寸" />
                            <TextBlock
                                Margin="0,3,0,0"
                                Style="{StaticResource SecondaryText}"
                                Text="未启用：保留原尺寸" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel IsEnabled="{Binding Settings.ResizeEnabled}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="宽度（可选）" />
                                    <TextBox Text="{Binding Settings.Width, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" IsEnabled="{Binding Settings.ResizeEnabled}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="高度（可选）" />
                                    <TextBox Text="{Binding Settings.Height, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                </StackPanel>
                            </Grid>
                            <CheckBox
                                IsChecked="{Binding Settings.LockAspectRatio}"
                                IsEnabled="{Binding Settings.ResizeEnabled}"
                                Content="锁定原始比例" />
                            <TextBlock Margin="0,10,0,5" Style="{StaticResource FieldLabel}" Text="画面比例" />
                            <ComboBox
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Settings.AspectRatioModes}"
                                SelectedValue="{Binding Settings.AspectRatioMode}"
                                SelectedValuePath="Value" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Settings.RatioWidth, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text=":" />
                                <TextBox Grid.Column="2" Text="{Binding Settings.RatioHeight, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <TextBlock Margin="0,8,0,5" Style="{StaticResource FieldLabel}" Text="裁剪锚点" />
                            <ComboBox
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Settings.CropAnchors}"
                                SelectedValue="{Binding Settings.CropAnchor}"
                                SelectedValuePath="Value" />
                        </StackPanel>
                    </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="AI 与背景">
                        <ScrollViewer
                            Padding="2,12,8,8"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                    <GroupBox Header="AI 抠图">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock
                                Margin="0,0,0,7"
                                Style="{StaticResource SecondaryText}"
                                Text="AI 抠图：在本机识别主体并生成透明背景。模型可在线下载或从本地文件导入，图片不会上传。"
                                TextWrapping="Wrap" />
                            <ComboBox
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Settings.BackgroundRemovalModes}"
                                SelectedValue="{Binding Settings.BackgroundRemovalMode}"
                                SelectedValuePath="Value" />
                            <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="BiRefNet 高精度人像模型" />
                            <TextBlock
                                Style="{StaticResource SecondaryText}"
                                Text="{Binding AiBackgroundRemoval.PortraitStatus}" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Command="{Binding AiBackgroundRemoval.InstallPortraitCommand}"
                                    Content="安装 / 重装" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding AiBackgroundRemoval.RemovePortraitCommand}"
                                    Content="删除" />
                            </Grid>
                            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="BiRefNet 高精度通用模型" />
                            <TextBlock
                                Style="{StaticResource SecondaryText}"
                                Text="{Binding AiBackgroundRemoval.GeneralStatus}" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Command="{Binding AiBackgroundRemoval.InstallGeneralCommand}"
                                    Content="安装 / 重装" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding AiBackgroundRemoval.RemoveGeneralCommand}"
                                    Content="删除" />
                            </Grid>
                            <Button
                                Margin="0,10,0,0"
                                Command="{Binding AiBackgroundRemoval.ImportLocalModelCommand}"
                                Content="从本地文件导入模型" />
                            <ProgressBar
                                Margin="0,10,0,0"
                                Value="{Binding AiBackgroundRemoval.DownloadProgress}" />
                            <Button
                                Margin="0,8,0,0"
                                Command="{Binding AiBackgroundRemoval.CancelInstallCommand}"
                                Content="取消模型操作" />
                            <TextBlock
                                Margin="0,7,0,0"
                                Foreground="{DynamicResource WarningBrush}"
                                Text="{Binding AiBackgroundRemoval.Notice}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Margin="0,16,0,0" Header="背景">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock
                                Margin="0,0,0,7"
                                Style="{StaticResource SecondaryText}"
                                Text="背景：保留、填充颜色或输出透明背景；AI 抠图模型可按需安装。"
                                TextWrapping="Wrap" />
                            <ComboBox
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Settings.BackgroundModes}"
                                SelectedValue="{Binding Settings.BackgroundMode}"
                                SelectedValuePath="Value" />
                            <TextBlock Margin="0,8,0,5" Style="{StaticResource FieldLabel}" Text="常用颜色" />
                            <StackPanel Orientation="Horizontal">
                                <Button Width="32" Height="32" MinHeight="32" Padding="0" Background="#FFFFFF" Tag="#FFFFFF" ToolTip="白色" Click="OnColorSwatchClick" />
                                <Button Width="32" Height="32" MinHeight="32" Margin="6,0,0,0" Padding="0" Background="#111111" Tag="#111111" ToolTip="黑色" Click="OnColorSwatchClick" />
                                <Button Width="32" Height="32" MinHeight="32" Margin="6,0,0,0" Padding="0" Background="#808080" Tag="#808080" ToolTip="灰色" Click="OnColorSwatchClick" />
                                <Button Width="32" Height="32" MinHeight="32" Margin="6,0,0,0" Padding="0" Background="#E53935" Tag="#E53935" ToolTip="红色" Click="OnColorSwatchClick" />
                                <Button Width="32" Height="32" MinHeight="32" Margin="6,0,0,0" Padding="0" Background="#1E88E5" Tag="#1E88E5" ToolTip="蓝色" Click="OnColorSwatchClick" />
                                <Button Width="32" Height="32" MinHeight="32" Margin="6,0,0,0" Padding="0" Background="#43A047" Tag="#43A047" ToolTip="绿色" Click="OnColorSwatchClick" />
                            </StackPanel>
                            <Button
                                x:Name="OpenBackgroundColorPickerButton"
                                Margin="0,8,0,0"
                                Click="OnChooseCustomBackgroundColor"
                                Content="打开颜色选择器" />
                            <Popup
                                x:Name="BackgroundColorPickerPopup"
                                AllowsTransparency="True"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=OpenBackgroundColorPickerButton}"
                                StaysOpen="False">
                                <Border
                                    Width="292"
                                    Margin="0,4,0,0"
                                    Padding="14"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,10" FontWeight="SemiBold" Text="选择接近的颜色" />
                                        <UniformGrid Columns="6">
                                            <Button Height="36" Margin="2" Padding="0" Background="#FFFFFF" Tag="#FFFFFF" ToolTip="白色" Click="OnColorSwatchClick" />
                                            <Button Height="36" Margin="2" Padding="0" Background="#E0E0E0" Tag="#E0E0E0" ToolTip="浅灰" Click="OnColorSwatchClick" />
                                            <Button Height="36" Margin="2" Padding="0" Background="#808080" Tag="#808080" ToolTip="灰色" Click="OnColorSwatchClick" />
                                            <Button Height="36" Margin="2" Padding="0" Background="#212121" Tag="#212121" ToolTip="深灰" Click="OnColorSwatchClick" />
                                            <Button Height="36" Margin="2" Padding="0" Background="#111111" Tag="#111111" ToolTip="黑色" Click="OnColorSwatchClick" />
                                            <Button Height="36" Margin="2" Padding="0" Background="#795548" Tag="#795548" ToolTip="棕色" Click="OnColorSwatchClick" />
                                            <Button Height="36" Margin="2" Padding="0" Background="#F44336" Tag="#F44336" ToolTip="红色" Click="OnColorSwatchClick" />
                                            <Button Height="36" Margin="2" Padding="0" Background="#FF9800" Tag="#FF9800" ToolTip="橙色" Click="OnColorSwatchClick" />
                                            <Button Height="36" Margin="2" Padding="0" Background="#FFEB3B" Tag="#FFEB3B" ToolTip="黄色" Click="OnColorSwatchClick" />
                                            <Button Height="36" Margin="2" Padding="0" Background="#4CAF50" Tag="#4CAF50" ToolTip="绿色" Click="OnColorSwatchClick" />
                                            <Button Height="36" Margin="2" Padding="0" Background="#00BCD4" Tag="#00BCD4" ToolTip="青色" Click="OnColorSwatchClick" />
                                            <Button Height="36" Margin="2" Padding="0" Background="#2196F3" Tag="#2196F3" ToolTip="蓝色" Click="OnColorSwatchClick" />
                                            <Button Height="36" Margin="2" Padding="0" Background="#3F51B5" Tag="#3F51B5" ToolTip="靛蓝" Click="OnColorSwatchClick" />
                                            <Button Height="36" Margin="2" Padding="0" Background="#673AB7" Tag="#673AB7" ToolTip="紫色" Click="OnColorSwatchClick" />
                                            <Button Height="36" Margin="2" Padding="0" Background="#E91E63" Tag="#E91E63" ToolTip="粉色" Click="OnColorSwatchClick" />
                                            <Button Height="36" Margin="2" Padding="0" Background="#FFF3E0" Tag="#FFF3E0" ToolTip="暖白" Click="OnColorSwatchClick" />
                                            <Button Height="36" Margin="2" Padding="0" Background="#E3F2FD" Tag="#E3F2FD" ToolTip="冷白" Click="OnColorSwatchClick" />
                                            <Button Height="36" Margin="2" Padding="0" Background="#F5F5F5" Tag="#F5F5F5" ToolTip="中性白" Click="OnColorSwatchClick" />
                                        </UniformGrid>
                                        <TextBlock
                                            Margin="0,9,0,0"
                                            Style="{StaticResource SecondaryText}"
                                            Text="需要精确颜色时，在下方输入十六进制值。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <TextBlock Margin="0,8,0,5" Style="{StaticResource FieldLabel}" Text="精确颜色值（#RRGGBB）" />
                            <TextBox Text="{Binding Settings.CustomBackgroundColor, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="0,7,0,0"
                                Foreground="{DynamicResource WarningBrush}"
                                Text="{Binding Settings.Notice}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="输出">
                        <ScrollViewer
                            Padding="2,12,8,8"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                    <GroupBox Header="输出">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock
                                Margin="0,0,0,7"
                                Style="{StaticResource SecondaryText}"
                                Text="输出：选择格式和保存规则。默认生成新文件，不覆盖原图。"
                                TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="输出格式" />
                            <ComboBox
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Settings.OutputFormats}"
                                SelectedValue="{Binding Settings.OutputFormat}"
                                SelectedValuePath="Value" />
                            <TextBlock Margin="0,8,0,5" Style="{StaticResource FieldLabel}" Text="保存位置" />
                            <ComboBox
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Settings.OutputModes}"
                                SelectedValue="{Binding Settings.OutputMode}"
                                SelectedValuePath="Value" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    IsReadOnly="True"
                                    Text="{Binding Settings.OutputDirectory, TargetNullValue=未选择}" />
                                <Button
                                    Grid.Column="2"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding ChooseOutputFolderCommand}"
                                    Content="&#xE8B7;"
                                    ToolTip="选择输出文件夹" />
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="元数据">
                        <ScrollViewer
                            Padding="2,12,8,8"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                    <GroupBox Header="元数据">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock
                                Margin="0,0,0,7"
                                Style="{StaticResource SecondaryText}"
                                Text="元数据：控制 EXIF、定位信息和色彩配置是否写入新图。"
                                TextWrapping="Wrap" />
                            <CheckBox IsChecked="{Binding Settings.PreserveExif}" Content="保留 EXIF" />
                            <CheckBox IsChecked="{Binding Settings.PreserveGps}" Content="保留 GPS 信息" />
                            <CheckBox IsChecked="{Binding Settings.PreserveIccProfile}" Content="保留 ICC 色彩配置" />
                            <CheckBox
                                IsChecked="{Binding Settings.ConvertToSrgbWhenIccCannotBePreserved}"
                                Content="不保留 ICC 时先转换为 sRGB" />
                        </StackPanel>
                    </GroupBox>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="外观">
                        <ScrollViewer
                            Padding="2,12,8,8"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                    <GroupBox Header="外观">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="主题" />
                            <ComboBox
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Appearance.ThemeOptions}"
                                SelectedValue="{Binding Appearance.Theme}"
                                SelectedValuePath="Value" />
                            <TextBlock Margin="0,8,0,5" Style="{StaticResource FieldLabel}" Text="工作区背景" />
                            <ComboBox
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Appearance.BackgroundOptions}"
                                SelectedValue="{Binding Appearance.WorkspaceBackground}"
                                SelectedValuePath="Value" />
                            <TextBlock Margin="0,8,0,5" Style="{StaticResource FieldLabel}" Text="自定义背景色" />
                            <TextBox Text="{Binding Appearance.CustomWorkspaceColor, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,8,0,5" Style="{StaticResource FieldLabel}" Text="字体大小" />
                            <ComboBox
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Appearance.FontSizeOptions}"
                                SelectedValue="{Binding Appearance.FontSize}"
                                SelectedValuePath="Value" />
                        </StackPanel>
                    </GroupBox>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Padding="18,12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="{Binding Progress.StatusText}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryText}"
                            Text="{Binding Progress.Percentage, StringFormat={}{0:F0}%}" />
                    </Grid>
                    <ProgressBar Margin="0,7,0,0" Value="{Binding Progress.Percentage}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Command="{Binding PauseResumeCommand}"
                    Content="{Binding PauseButtonText}" />
                <Button
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    Style="{StaticResource DangerButton}"
                    Command="{Binding CancelCommand}"
                    Content="取消" />
                <Button
                    Grid.Column="3"
                    Margin="0,0,8,0"
                    Command="{Binding RetryFailedCommand}"
                    Content="重试失败项" />
                <Button
                    Grid.Column="4"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding StartNextBatchCommand}"
                    Content="新建批次"
                    Visibility="{Binding ShowNewBatchAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button
                    Grid.Column="4"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding StartCommand}"
                    Content="{DynamicResource StartText}"
                    Visibility="{Binding ShowStartAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>

        <Grid
            Grid.RowSpan="3"
            Grid.ColumnSpan="3"
            Panel.ZIndex="20"
            Visibility="{Binding IsCompletionNoticeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#66000000" />
            <Border
                Width="380"
                Padding="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="已完成" />
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource IconButton}"
                            Command="{Binding DismissCompletionNoticeCommand}"
                            Content="&#xE711;"
                            ToolTip="关闭" />
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,16,0,18"
                        LineHeight="23"
                        Text="{Binding CompletionNoticeText}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Row="2"
                        Width="96"
                        HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding DismissCompletionNoticeCommand}"
                        Content="确定" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
